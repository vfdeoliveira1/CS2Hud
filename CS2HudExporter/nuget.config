<?xml version="1.0" encoding="utf-8"?>
<!-- Garante que o restore use o nuget.org em qualquer máquina, mesmo que
     a instalação local do .NET/Visual Studio não tenha essa fonte. -->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>

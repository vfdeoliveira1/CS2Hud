<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- Roda no .NET 8 se existir; senão, na próxima versão principal instalada
         (9, 10...). Assim funciona em qualquer máquina com .NET 8 ou superior. -->
    <RollForward>Major</RollForward>
    <!-- Não gera o CS2HudExporter.exe: o app roda pelo dotnet.exe (assinado
         pela Microsoft). O Controle Inteligente de Aplicativos do Windows
         bloqueia o .exe gerado, que não tem assinatura digital. -->
    <UseAppHost>false</UseAppHost>
  </PropertyGroup>

</Project>